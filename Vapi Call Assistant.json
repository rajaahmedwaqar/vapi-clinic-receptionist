      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst message = body.message || body;\nconst call = message.call || {};\nconst analysis = message.analysis || {};\n \nfunction parseArgs(raw) {\n  if (!raw) return {};\n  if (typeof raw === 'object') return raw;\n  try { return JSON.parse(raw); } catch (e) { return {}; }\n}\n \n// Two possible payload shapes coming from Vapi:\n// 1) \"tool-calls\" event (fires mid-call): the save_call_data arguments live at\n//    the top level, message.toolCalls[0].function.arguments\n// 2) \"end-of-call-report\" event (fires when the call ends): message.toolCalls\n//    is NOT present at the top level. The save_call_data call that happened\n//    during the conversation is instead buried inside\n//    message.artifact.messages[], as one of the message entries with a\n//    toolCalls array. We have to search for it there.\nlet toolCall = (message.toolCalls && message.toolCalls[0]) || null;\nconst isLiveToolCallEvent = !!toolCall;\n \nif (!toolCall) {\n  const artifactMessages = (message.artifact && message.artifact.messages) || [];\n  for (const m of artifactMessages) {\n    if (Array.isArray(m.toolCalls)) {\n      const found = m.toolCalls.find(\n        tc => tc.function && tc.function.name === 'save_call_data'\n      );\n      if (found) {\n        toolCall = found;\n        break;\n      }\n    }\n  }\n}\n \nconst toolArgs = toolCall ? parseArgs(toolCall.function && toolCall.function.arguments) : {};\nconst toolCallId = toolCall ? toolCall.id : null;\n \nconst structured = analysis.structuredData || message.structuredData || toolArgs || {};\n \nfunction clean(val, fallback) {\n  if (val === undefined || val === null) return fallback;\n  const s = String(val).trim();\n  return s.length ? s : fallback;\n}\n \nfunction normalizeReason(raw) {\n  if (!raw) return 'General Inquiry';\n  const r = String(raw).toLowerCase().replace(/[_]+/g, ' ').trim();\n  if (r.includes('reschedul')) return 'Reschedule';\n  if (r.includes('new appointment') || r.includes('booking')) return 'New Appointment';\n  return 'General Inquiry';\n}\n \nconst callerName = clean(structured.caller_name || structured.callerName, 'Not provided');\nconst reasonForCall = normalizeReason(structured.reason_for_call || structured.reasonForCall);\nconst requestedDatetime = clean(\n  structured.requested_datetime || structured.requestedDateTime || structured.preferred_datetime || structured.preferredDatetime,\n  'Not provided'\n);\nconst callbackNumberRaw = clean(\n  structured.callback_number || structured.callbackNumber || (call.customer && call.customer.number),\n  'Not provided'\n);\n// Airtable's \"CallBack number\" column is a Number field, so strip everything\n// except digits (drops the leading \"+\" etc.) or it will fail to save.\nconst callbackNumber = callbackNumberRaw === 'Not provided'\n  ? 'Not provided'\n  : callbackNumberRaw.replace(/[^0-9]/g, '');\n \n// Never mark a call Booked unless a real booking system explicitly confirmed it.\nlet callStatus = 'New';\nconst explicitlyBooked = structured.booking_confirmed === true || structured.call_status === 'Booked';\nif (explicitlyBooked) {\n  callStatus = 'Booked';\n} else if (\n  callerName === 'Not provided' ||\n  callbackNumber === 'Not provided' ||\n  (requestedDatetime === 'Not provided' && reasonForCall !== 'General Inquiry')\n) {\n  callStatus = 'Needs Follow Up';\n}\n \nconst timestamp = call.startedAt || message.timestamp || new Date().toISOString();\n \nconst summary = analysis.summary || message.summary;\nconst transcript = message.transcript || call.transcript;\nconst transcriptOrSummary = clean(summary || transcript, 'No transcript or summary available.');\n \n// A payload counts as \"valid\" if we can identify it as an actual Vapi call event\n// (has a call object, analysis object, structured data, transcript, or a tool call\n// found either at the top level or inside the artifact).\nconst rawValid = !!(call.id || analysis.summary || Object.keys(structured).length > 0 || message.transcript || toolCall);\n \nreturn [\n  {\n    json: {\n      caller_name: callerName,\n      reason_for_call: reasonForCall,\n      requested_datetime: requestedDatetime,\n      callback_number: callbackNumber,\n      call_status: callStatus,\n      timestamp: timestamp,\n      transcript_or_summary: transcriptOrSummary,\n      _raw_valid: rawValid,\n      _is_tool_call: isLiveToolCallEvent,\n      _tool_call_id: toolCallId,\n      _event_type: message.type || null\n    }\n  }\n];"
      },
